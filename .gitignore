# State files — tracked so remote CCR agents have persistent deduplication across runs.
# These files grow over time with LinkedIn profile data — treat the repo as private.
# state/

# Criteria files are safe to commit — they contain no PII, only search patterns
# config/criteria/ is intentionally tracked

# Raw profile sidecars — bulky, re-derivable via `linkedin person fetch`.
# Not needed for dedupe (seen.json is); remote agents re-fetch on demand.
state/raw/

# Local secrets — never commit
.claude/settings.local.json
.env

# OS / editor noise
.DS_Store
*.swp
*.swo
