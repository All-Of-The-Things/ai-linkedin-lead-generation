{
  "version": "1",
  "active_criteria": "agency-partners",
  "linkedin_provider": {
    "active": "connectsafely"
  },
  "search": {
    "max_results_per_run": 25,
    "max_search_queries_per_run": 3,
    "search_rotation_strategy": "round_robin",
    "min_hot_leads_per_run": 5,
    "max_search_batches_per_run": 4
  },

  "enrichment": {
    "enabled": false
  },
  "outreach": {
    "max_connection_requests_per_run": 10,
    "require_approval_before_connect": true
  },
  "followup": {
    "delay_days_min": 2,
    "delay_days_max": 4,
    "delay_strategy": "random_in_range",
    "max_followups_per_run": 5,
    "require_approval_before_send": true,
    "max_sequence": 2
  },
  "approval": {
    "pending_file": "state/pending_approvals.json",
    "approval_timeout_days": 3
  },
  "rate_limit": {
    "retry_on_exit_6": true,
    "max_retries": 2,
    "retry_delay_seconds": 120
  },
  "criteria_refresh": {
    "auto_refresh_every_n_runs": 7
  },
  "run_log": "state/run_log.json",

  "review": {
    "page_size": 30,
    "split_by_classification": true,
    "email_suppress_cold": true
  },

  "warm_up": {
    "max_leads_per_run": 10,
    "posts_to_fetch_per_lead": 3,
    "reaction_type": "insightful",
    "require_approval_before_comment": true,
    "skip_if_warmed_up_within_days": 14
  },

  "connections_cache": {
    "file": "state/connections_cache.json",
    "ttl_days": 7
  },

  "invite_recovery": {
    "csv_import_dir": "state/imports",
    "stale_after_days": 7,
    "match_date_tolerance_days": 3,
    "require_approval_before_withdraw": false,
    "require_approval_before_inmail": true,
    "max_withdrawals_per_run": 15,
    "max_inmails_per_run": 15
  },

  "notifications": {
    "from": "AOTT Pipeline <hello@allofthethings.dev>",
    "to": "martin@allofthethings.dev",
    "subject_prefix": "[AOTT LinkedIn]"
  }
}
